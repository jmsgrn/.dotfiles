# Global git config - $XDG_CONFIG_HOME/git/config
# Identity (name/email) goes in ~/.config/git/config.local, which is NOT tracked
# - keeps personal identity off the public repo
# - lets a work machine override with work email via the same file

[include]
  path = ~/.config/git/config.local

[init]
  defaultBranch = main

[pull]
  rebase = false

[push]
  default = current
  autoSetupRemote = true

[core]
  editor = code --wait
  excludesfile = ~/.config/git/ignore
	hooksPath = ~/.config/git/hooks

[diff]
  algorithm = histogram
  colorMoved = default

[merge]
  conflictstyle = zdiff3

[rerere]
  enabled = true

[color]
  ui = auto

[alias]
  s = status
  co = checkout
  br = branch
  cm = commit -m
  last = log -1 HEAD
  amend = commit --amend --no-edit
  unstage = restore --staged
  graph = log --oneline --graph --decorate --all
  undo    = reset --soft HEAD~1
  please  = push --force-with-lease
  wip     = !git add -A && git commit -m 'wip' --no-verify
  recent  = for-each-ref --sort=-committerdate --count=15 --format='%(refname:short)'
  cleanup = !git branch --merged main | grep -v '\\*\\|main' | xargs -r git branch -d
  aliases = config --get-regexp ^alias\\.

# Use the `gh` CLI as the credential helper for github.com and gist.github.com.
# Empty `helper =` first clears any inherited helpers; second line installs gh.
[credential "https://github.com"]
  helper =
  helper = !gh auth git-credential

[credential "https://gist.github.com"]
  helper =
  helper = !gh auth git-credential
